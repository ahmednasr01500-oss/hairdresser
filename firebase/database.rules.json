// ═══════════════════════════════════════════════════════════════════════
// قواعد أمان قاعدة البيانات — تطبيق أخضر
//
// الفكرة: الكتالوج مقروء للكل (عشان العميل يتفرّج قبل ما يسجّل)، بس
// الكتابة عليه لصاحب المحل بس. والطلبات كل عميل يشوف طلباته هو بس.
//
// صاحب المحل بيتعرّف عليه من وجود UID بتاعه في admins/ — مش من إيميله،
// عشان لو غيّر الإيميل بعدين ما يقفلش على نفسه.
//
// ملاحظة: قواعد Firebase بتقبل تعليقات // زي دي، بس **متكتبش** تعليق
// على شكل مفتاح ‎"//"‎ جوه أي عقدة — Firebase بيفهم أي مفتاح مش
// ‎.read/.write/.validate‎ على إنه اسم مسار وبيطلب قيمته تبقى { }.
//
// طريقة الرفع: Realtime Database ← Rules ← الزق ده كله ← Publish
// (موصوفة في SETUP.md خطوة ٤)
// ═══════════════════════════════════════════════════════════════════════

{
  "rules": {
    ".read": false,
    ".write": false,

    // مين صاحب المحل. بتتكتب من Firebase Console بس — لا التطبيق ولا
    // اللوحة يقدروا يغيّروها.
    //
    // كل حساب يقدر يشوف صلاحيته هو بس، ومحدش يقدر يجيب قايمة الأدمنز.
    // ده عشان اللوحة تعرف تقول لصاحب المحل "حسابك لسه مش مصرّح له"
    // بدل ما الحفظ يترفض في صمت والتغيير يختفي من غير سبب واضح.
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    // ── الكتالوج: قراءة للكل، كتابة لصاحب المحل ──────────────────────
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "banners": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    // أكواد الخصم: العميل يقدر يتحقق من كود هو عارفه، لكن ما يقدرش يجيب
    // قايمة الأكواد كلها — القراءة على الكود المحدد بس.
    "coupons": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": true
      }
    },

    // عدّاد أرقام الطلبات القصيرة. أي عميل مسجّل يقدر يزوّده بواحد وقت
    // الطلب، بس ما يقدرش يرجّعه لورا ولا يحطّ فيه أي حاجة غير رقم.
    "counters": {
      "orderNumber": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() > data.val())"
      }
    },

    // ── الطلبات ──────────────────────────────────────────────────────
    // ملكية الطلب على رقم تليفون العميل مش على معرّف الجهاز، عشان بياناته
    // ما تضيعش لو مسح التطبيق ونزّله تاني.
    //
    // النتيجة المقصودة والمتوافق عليها: أي حد مسجّل في التطبيق ويكتب رقم
    // حد تاني هيشوف طلباته. الرقم هنا وسيلة تعريف مش إثبات هوية — الإثبات
    // محتاج كود تحقق بالرسايل وده مدفوع.
    //
    // اللي القواعد لسه بتمنعه: قراءة قايمة الطلبات كلها، وتعديل مبلغ أو
    // وقت طلب موجود، ونقل طلب من رقم لرقم.
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true || (newData.child('phone').val() === data.child('phone').val() && newData.child('total').val() === data.child('total').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
        ".validate": "newData.hasChildren(['phone', 'status', 'createdAt', 'total'])"
      }
    },

    // فهرس طلبات كل رقم.
    "user_orders": {
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    // ملف العميل: اسمه وعناوينه، متخزّن على رقمه عشان يرجعله بعد إعادة
    // التركيب. قايمة العملاء كلها لصاحب المحل بس.
    "customers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
