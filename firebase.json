{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "hosting": {
    "public": "hosting",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "//": "المتصفح لازم ينزّل ملف الـ APK مش يحاول يعرضه.",
        "source": "**/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "//": "صفحة التحميل ولوحة التحكم لازم يتحدّثوا فورًا بعد أي نشرة.",
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ]
  }
}
